# Supabase Configuration
# Dapatkan kredensial ini di Dashboard Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mode Demo (Pengujian / Presentasi)
# Set ke 'false' pada lingkungan produksi (Vercel) untuk menonaktifkan tombol login demo
VITE_ALLOW_DEMO_MODE=true
